
// REUSABLE TOAST FUNCTION
function showToast(message) {

    let toast = document.getElementById("toast");

    if (!toast) {
        toast = document.createElement("div");
        toast.id = "toast";
        document.body.appendChild(toast);
    }

    toast.textContent = message;
    toast.className = "show";

    setTimeout(function () {
        toast.className = "";
    }, 3000);
}


// SMOOTH SCROLLING TO MATCH SCHEDULE
document.addEventListener("DOMContentLoaded", function () {

    const matchLinks = document.querySelectorAll(
        'a[href="#matches"]'
    );

    matchLinks.forEach(function (link) {

        link.addEventListener("click", function (event) {

            event.preventDefault();

            document.getElementById("matches").scrollIntoView({
                behavior: "smooth"
            });

            showToast("Viewing IPL match schedule!");

        });

    });

});

function showMatch() {
    const match = document.getElementById("matchSelect").value;
    const details = document.getElementById("matchDetails");

    const matches = {
        "RCB vs Mumbai Indians": {
            date: "April 5, 2026",
            time: "7:30 PM",
            stadium: "Wankhede Stadium",
            city: "Mumbai"
        },

        "CSK vs Kolkata Knight Riders": {
            date: "April 6, 2026",
            time: "7:30 PM",
            stadium: "MA Chidambaram Stadium",
            city: "Chennai"
        },

        "Delhi Capitals vs Sunrisers Hyderabad": {
            date: "April 7, 2026",
            time: "7:30 PM",
            stadium: "Arun Jaitley Stadium",
            city: "Delhi"
        },

        "Rajasthan Royals vs Punjab Kings": {
            date: "April 8, 2026",
            time: "7:30 PM",
            stadium: "Sawai Mansingh Stadium",
            city: "Jaipur"
        }
    };

    if (match === "") {
        details.innerHTML = "Please select a match!";
        return;
    }

    const selectedMatch = matches[match];

    details.innerHTML = `
        <h3>${match}</h3>
        <p><strong>Date:</strong> ${selectedMatch.date}</p>
        <p><strong>Time:</strong> ${selectedMatch.time}</p>
        <p><strong>Stadium:</strong> ${selectedMatch.stadium}</p>
        <p><strong>City:</strong> ${selectedMatch.city}</p>
    `;
}
